{
  "info": {
    "name": "Aldwino Event API",
    "description": "CRUD requests for testing the Event domain (app/api backend)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:4287",
      "type": "string"
    },
    {
      "key": "eventId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Create Event (valid)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    const json = pm.response.json();",
              "    pm.collectionVariables.set(\"eventId\", json.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"startTime\": \"2026-07-15T10:00:00Z\",\n  \"endTime\": \"2026-07-15T11:00:00Z\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/events",
          "host": ["{{baseUrl}}"],
          "path": ["events"]
        },
        "description": "Creates an event and saves its id to the {{eventId}} collection variable for use by subsequent requests."
      }
    },
    {
      "name": "List Events",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/events",
          "host": ["{{baseUrl}}"],
          "path": ["events"]
        }
      }
    },
    {
      "name": "Get Event By Id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/events/{{eventId}}",
          "host": ["{{baseUrl}}"],
          "path": ["events", "{{eventId}}"]
        }
      }
    },
    {
      "name": "Update Event (valid)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"startTime\": \"2026-07-15T14:00:00Z\",\n  \"endTime\": \"2026-07-15T15:00:00Z\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/events/{{eventId}}",
          "host": ["{{baseUrl}}"],
          "path": ["events", "{{eventId}}"]
        }
      }
    },
    {
      "name": "Delete Event",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/events/{{eventId}}",
          "host": ["{{baseUrl}}"],
          "path": ["events", "{{eventId}}"]
        }
      }
    },
    {
      "name": "Get Event By Id (after delete, expect 404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/events/{{eventId}}",
          "host": ["{{baseUrl}}"],
          "path": ["events", "{{eventId}}"]
        }
      }
    },
    {
      "name": "Validation - Different Days (expect 400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"startTime\": \"2026-07-15T10:00:00Z\",\n  \"endTime\": \"2026-07-16T11:00:00Z\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/events",
          "host": ["{{baseUrl}}"],
          "path": ["events"]
        },
        "description": "startTime and endTime fall on different calendar days -> should return 400 SameDayViolation"
      }
    },
    {
      "name": "Validation - startTime After endTime (expect 400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"startTime\": \"2026-07-15T15:00:00Z\",\n  \"endTime\": \"2026-07-15T14:00:00Z\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/events",
          "host": ["{{baseUrl}}"],
          "path": ["events"]
        },
        "description": "startTime is after endTime -> should return 400 TimeOrderViolation"
      }
    },
    {
      "name": "Validation - Equal startTime/endTime (expect 400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"startTime\": \"2026-07-15T12:00:00Z\",\n  \"endTime\": \"2026-07-15T12:00:00Z\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/events",
          "host": ["{{baseUrl}}"],
          "path": ["events"]
        },
        "description": "startTime equal to endTime means zero duration -> should return 400 ZeroDurationViolation"
      }
    },
    {
      "name": "Validation - Invalid Date Format (expect 400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"startTime\": \"not-a-date\",\n  \"endTime\": \"2026-07-15T11:00:00Z\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/events",
          "host": ["{{baseUrl}}"],
          "path": ["events"]
        },
        "description": "Malformed ISO 8601 string -> should return 400"
      }
    },
    {
      "name": "Validation - Missing Fields (expect 400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"startTime\": \"2026-07-15T10:00:00Z\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/events",
          "host": ["{{baseUrl}}"],
          "path": ["events"]
        },
        "description": "endTime missing from body -> should return 400"
      }
    },
    {
      "name": "Get Event By Id (unknown id, expect 404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/events/00000000-0000-0000-0000-000000000000",
          "host": ["{{baseUrl}}"],
          "path": ["events", "00000000-0000-0000-0000-000000000000"]
        }
      }
    },
    {
      "name": "Update Event (unknown id, expect 404)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"startTime\": \"2026-07-15T10:00:00Z\",\n  \"endTime\": \"2026-07-15T11:00:00Z\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/events/00000000-0000-0000-0000-000000000000",
          "host": ["{{baseUrl}}"],
          "path": ["events", "00000000-0000-0000-0000-000000000000"]
        }
      }
    },
    {
      "name": "Delete Event (unknown id, expect 404)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/events/00000000-0000-0000-0000-000000000000",
          "host": ["{{baseUrl}}"],
          "path": ["events", "00000000-0000-0000-0000-000000000000"]
        }
      }
    }
  ]
}
