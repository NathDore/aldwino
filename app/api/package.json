{
  "name": "@aldwino/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config ../../eslint.config.mjs .",
    "compile:host": "bun run scripts/compile-sidecar.ts",
    "compile:win-x64": "bun build ./src/index.ts --compile --target=bun-windows-x64 --outfile ../../src-tauri/binaries/app-api-x86_64-pc-windows-msvc.exe",
    "compile:mac-arm64": "bun build ./src/index.ts --compile --target=bun-darwin-arm64 --outfile ../../src-tauri/binaries/app-api-aarch64-apple-darwin",
    "compile:mac-x64": "bun build ./src/index.ts --compile --target=bun-darwin-x64 --outfile ../../src-tauri/binaries/app-api-x86_64-apple-darwin"
  },
  "dependencies": {
    "hono": "^4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
